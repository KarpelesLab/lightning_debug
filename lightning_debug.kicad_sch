	(text "ch.A: ADBUS0 SCK, 1 MOSI, 2 MISO, 4 CS#, 6 CDONE, 7 CRESET#  (iceprog default)\nch.B: BDBUS0 TXD->FPGA, 1 RXD<-FPGA, 2 RTS#, 3 CTS#  (MPSSE: SCK/MOSI/MISO/CS)"
		(exclude_from_sim no)
