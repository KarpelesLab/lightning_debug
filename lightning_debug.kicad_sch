			)
			(justify left top)
		)
		(uuid "59f42354-d0a0-456d-8159-e8ca58ab246a")
	)
	(text "Both footprints carry the same nets. Pin N = same Lightning contact on both boards:\nside A 1..8 = GND, L0p, L0n, ID0, PWR, L1n, L1p, ID1 ; side B mirrored (pin 17-k = pin k).\nJ3 = APPLE-LM-BO-V1AV (vertical plug), J4 = APPLE-LM-BO-V2A (plug overhangs board edge)."
		(exclude_from_sim no)
		(at 20 193 0)
		(effects
